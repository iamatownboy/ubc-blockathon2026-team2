NODE_ENV=production
IDENTITY_SECRET=replace-with-at-least-32-random-bytes
ADMIN_TOKEN=replace-with-a-long-random-admin-token
VERIFIER_TOKEN=replace-with-a-different-long-random-verifier-token
LEDGER=chain
PROVIDER_URL=https://provider-sandbox.example
PROVIDER_CERT=replace-with-provider-issued-credential
DATA_FILE=.data/state.json
# Participation codes issued by the partner desks (library, settlement agency,
# school). The server stores only an HMAC of each code and derives the learner
# handle from it, so one code is one person's lifetime cap. Required in
# production; ENROLLMENT=open disables the check and is not a pilot setting.
ENROLLMENT=required
ENROLLMENT_CODES=replace,with,the,issued,code,list
# Optional: enable only when the learner-facing consent prompt is appropriate.
COACH=offline
